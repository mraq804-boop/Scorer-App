# Copy to .env.local for development. In Vercel, set the same names under
# Project Settings -> Environment Variables. Never commit real values.

# Supabase (Project Settings -> API Keys). The app uses only the publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public URL of the app (used in share links and preview images)
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Cloudflare Turnstile site key for guest sign-in. Optional; leave empty when
# CAPTCHA is off in Supabase. Cloudflare's always-pass test key is 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# How often the live match page polls when Realtime is unavailable (milliseconds)
NEXT_PUBLIC_POLL_MS=5000

# Seconds the polling route may be cached at the CDN (s-maxage)
LIVE_CACHE_SECONDS=2
